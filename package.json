{
  "name": "@nakednous/host",
  "version": "0.0.13",
  "description": "host — DOM transport for @nakednous/tree: pointer, handles, players, device streams, media. Zero renderer.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "node --test test/",
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "reset": "rm -rf node_modules dist package-lock.json && npm install",
    "link:core": "npm install --no-save file:../tree --prefer-online",
    "unlink:core": "npm uninstall --no-save @nakednous/tree && npm install @nakednous/tree --prefer-online",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run link:core"
  },
  "keywords": [
    "tree",
    "pointer",
    "manipulator",
    "handle",
    "helm",
    "keyframes",
    "webhid",
    "gamepad",
    "dom"
  ],
  "author": "Jean Pierre Charalambos <nakednous@gmail.com>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakednous/host.git"
  },
  "dependencies": {
    "@nakednous/tree": "^0.0.35"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.68.2"
  }
}
